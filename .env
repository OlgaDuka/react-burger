# --- Локальный PostgreSQL (поднимается через `npm run db`) ---
PG_PORT=5433
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=react_burger

# --- API-сервер ---
API_PORT=3001
DATABASE_URL=postgres://postgres:postgres@localhost:5433/react_burger
JWT_SECRET=react-burger-dev-secret
JWT_ACCESS_TTL=20m
JWT_REFRESH_TTL_DAYS=30
# Разрешённые источники фронтенда через запятую, например:
#   CORS_ORIGIN=http://localhost:3000,http://localhost:3005
CORS_ORIGIN=http://localhost:3000
# true — при первом запуске создать демо-пользователей и историю заказов
SEED_DEMO_DATA=true

# --- Фронтенд (Vite отдаёт в браузер только переменные с префиксом VITE_) ---
# Оригинальный учебный API: https://norma.education-services.ru
VITE_API_URL=http://localhost:3001

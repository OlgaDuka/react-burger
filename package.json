    "fetch-mock": "^12.3.0",
    "gh-pages": "^6.3.0",
    "jsdom": "^31.0.1",
    "react-test-renderer": "^18.3.1",
    "redux-mock-store": "^1.5.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}

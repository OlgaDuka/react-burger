    "@ya.praktikum/react-developer-burger-ui-components": "^1.14.2",
    "core-js": "^3.51.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^4.21.2",
    "framer-motion": "^12.38.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.28.0",
    "redux": "^5.0.1",
    "redux-thunk": "^3.1.0",
    "uuid": "^11.0.3",
    "web-vitals": "^2.1.4",
    "ws": "^8.23.0"
  },
  "scripts": {
    "start": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "concurrently -k -n db,api,web -c blue,green,magenta \"npm:db\" \"npm:api\" \"npm:start\"",
    "db": "node scripts/db.mjs",
    "db:migrate": "tsx server/cli/db.ts migrate",
    "db:seed": "tsx server/cli/db.ts seed",
    "db:reset": "tsx server/cli/db.ts reset",
    "db:stats": "tsx server/cli/db.ts stats",
    "api": "tsx watch server/index.ts",
    "api:start": "tsx server/index.ts",
    "typecheck:server": "tsc -p server/tsconfig.json",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "deploy:docker": "scp ../Dockerfile-burger.pub ../.env leliduk@158.160.168.244:/home/leliduk/docker"
  },
  "devDependencies": {
    "@embedded-postgres/windows-x64": "^18.6.0-beta.19",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.2.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
